{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.spb_hmp.aim": {
			"initial_state": "idle",
			"states": {
				"idle": {
					"transitions": [
						{ "aim": "query.variant == 1" }
					]
				},
				"aim": {
					"animations": [ "aim_anim" ],
					"transitions": [
						{ "idle": "query.variant != 1" }
					]
				}
			}
		}
	}
}