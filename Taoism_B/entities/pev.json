{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "entity:pev",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false,
      "scripts": {
				"animate": [
					"pev_choice",
          "pev_lock",
          "pev_bgm"
				]
			},
      "animations": {
				"pev_choice": "controller.animation.pev_choice",
        "pev_lock": "controller.animation.pev_lock",
        "pev_bgm": "controller.animation.pev_bgm"
			}
    },
    "component_groups": {
      "despawn": {
        "minecraft:instant_despawn": {}
      }
    },
    "events": {
