          "component_groups": [
            "despawn"
          ]
        }
      }
    },
    "components": {
      "minecraft:interact": {
        "interactions": [
          {
            "on_interact": {
              "filters": {
                "all_of": [
                  { "test": "is_family", "subject": "other", "value": "player" },
                  { "test": "has_equipment", "subject": "other", "domain": "hand", "value": "items:scripture_s" }
                ]
              },
              "event": "despawn",
              "target": "self"
            },
            "use_item": false,
            "interact_text": "addon.get.items"
          }
        ]
      },
      "minecraft:despawn": {
        "despawn_from_distance": {}
      },
      "minecraft:nameable": {
      },
      "minecraft:type_family": {
        "family": [
          "taoism",
          "mob"
        ]
      },
      "minecraft:collision_box": {
        "width": 0.6,
        "height": 1.9
      },
      "minecraft:movement": {
          "value": 0.3
        },
      "minecraft:can_have_equipment": {
      },  
      "minecraft:movement.basic": {
      },
      "minecraft:navigation.walk": {
        "is_amphibious": true,
        "can_pass_doors": true,
        "can_walk": true,
        "can_break_doors": true
      },
      "minecraft:annotation.break_door": {
      },
      "minecraft:jump.static": {
      },
      "minecraft:can_climb": {
      },
      "minecraft:health": {
        "value": 300,
        "max": 300
      },
      "minecraft:boss": {
        "name": "entity.entity:pev.name",
        "should_darken_sky": true,
        "hud_range": 55
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": { "test": "in_lava", "subject": "self", "operator": "==", "value": true },
            "cause": "lava",
            "damage_per_tick": 1
          }
        ]
      },
      "minecraft:fire_immune": {},
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0,
        "breathes_air": true,
        "breathes_water": true
      },
      "minecraft:attack": {
        "damage": 1
      },
      "minecraft:behavior.melee_attack": {
        "priority": 2,
        "speed_multiplier": 1,
        "target_dist": 0,
        "max_dist": 1,
        "random_stop_interval": 0,
        "track_target": true,
        "reach_multiplier": 1
      },
      "minecraft:behavior.move_towards_restriction": {
        "priority": 5,
        "speed_multiplier": 1
