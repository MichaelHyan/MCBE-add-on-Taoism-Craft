{
  "format_version": "1.26.20",
  "minecraft:entity": {
    "description": {
      "identifier": "entity:zombie_mimic_n",
      "is_summonable": true,
      "is_spawnable": false,
      "spawn_category": "monster"
    },
    "components": {
      "minecraft:attack": {
        "damage": 3
      },
      "minecraft:behavior.equip_item": {
        "priority": 2
      },
      "minecraft:behavior.hurt_by_target": {
        "entity_types": [
          {
            "filters": {
              "operator": "not",
              "test": "is_family",
              "subject": "other",
              "value": "breeze"
            }
          }
        ],
        "priority": 1
      },
      "minecraft:behavior.look_at_player": {
        "look_distance": 6,
        "priority": 8
      },
      "minecraft:behavior.melee_box_attack": {
        "can_spread_on_fire": true,
        "priority": 4
      },
      "minecraft:behavior.nearest_attackable_target": {
        "reselect_targets": true,
        "must_see": true,
        "within_radius": 25,
        "must_see_forget_duration": 17,
        "entity_types": [
          {
            "filters": {
              "any_of": [
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "player"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "snowgolem"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "irongolem"
                }
              ]
            },
            "max_dist": 35
          },
          {
            "filters": {
              "any_of": [
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "villager"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "wandering_trader"
                }
              ]
            },
            "max_dist": 35,
            "must_see": false
          },
          {
            "filters": {
              "all_of": [
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "baby_turtle"
                },
                {
                  "test": "in_water",
                  "subject": "other",
                  "value": false
                }
              ]
            },
            "max_dist": 35
          }
        ],
        "priority": 2
      },
      "minecraft:behavior.pickup_items": {
        "can_pickup_any_item": true,
        "excluded_items": [
          "minecraft:glow_ink_sac"
        ],
        "pickup_based_on_chance": true,
        "goal_radius": 2,
        "priority": 6,
        "max_dist": 3,
        "speed_multiplier": 1
      },
      "minecraft:behavior.random_look_around": {
        "priority": 9
      },
      "minecraft:behavior.random_stroll": {
        "priority": 7,
        "speed_multiplier": 1
      },
      "minecraft:breathable": {
        "breathes_air": true,
        "breathes_water": true,
        "suffocate_time": 0,
        "total_supply": 15
      },
      "minecraft:burns_in_daylight": {},
      "minecraft:can_climb": {},
      "minecraft:collision_box": {
        "height": 1.9,
        "width": 0.6
      },
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:despawn": {
        "despawn_from_distance": {}
      },
      "minecraft:equip_item": {
        "excluded_items": [
          {
            "item": "minecraft:banner:15"
          }
        ]
      },
      "minecraft:health": {
        "max": 20,
        "value": 20
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "cause": "lava",
            "damage_per_tick": 4,
            "filters": {
              "test": "in_lava"
            }
          }
        ]
      },
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:jump.static": {},
      "minecraft:movement.basic": {},
      "minecraft:nameable": {},
      "minecraft:navigation.walk": {
        "can_break_doors": true,
        "is_amphibious": true,
        "can_pass_doors": true,
        "can_walk": true
      },
      "minecraft:offspring": {
        "offspring_pairs": {
          "minecraft:zombie": "minecraft:zombie"
        }
      },
      "minecraft:timer": {
        "looping": true,
        "randomInterval": false,
        "time": 600.0,
        "time_down_event": {
          "event": "despawn",
          "target": "self"
        }
      },
      "minecraft:physics": {},
      "minecraft:pushable_by_entity": {
      },
      "minecraft:pushable_by_block": {
      },
      "minecraft:rotation_locked_to_vehicle": {},
      "minecraft:type_family": {
        "family": [
          "zombie",
          "undead",
          "monster",
          "mob"
        ]
      },
      "minecraft:interact": {
        "interactions": [
          {
            "interact_text": "action.interact.talk",
            "use_item": false,
            "on_interact": {
              "filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "player"
                  },
                  {
                    "test": "has_equipment",
                    "subject": "other",
                    "domain": "hand",
                    "value": "minecraft:stick"
                  }
                ]
              },
              "event": "test_interact",
              "target": "self"
            }
          }
        ]
      }
    },
    "component_groups": {
        "despawn": {
            "minecraft:instant_despawn": {}
        }
    },
    "events": {
        "despawn": {
        "add": {
          "component_groups": [
            "despawn"
          ]
        }
      },
      "test_interact": {
        "queue_command": {
          "command": "say zombie_mimic_n: 交互事件触发成功",
          "target": "self"
        }
      }
    }
  }
}