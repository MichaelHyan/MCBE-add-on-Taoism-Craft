          "value": 1
        },
        "minecraft:angry": {
          "duration": -1,
          "broadcastAnger": false,
          "calm_event": {
            "event": "stop_anger",
            "target": "self"
          }
        },
        "minecraft:timer": {
          "looping": true,
          "randomInterval": false,
