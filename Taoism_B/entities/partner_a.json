      },
      "minecraft:interact": [
        {
          "on_interact": {
            "filters": {
              "all_of": [
                {
                  "test": "has_equipment",
                  "subject": "other",
                  "domain": "hand",
                  "value": "items:hy_banner"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "player"
                }
              ]
            },
            "event": "refresh"
          },
          "use_item": false,
          "interact_text": "addon.get.items"
        }
      ],
      "minecraft:behavior.nearest_attackable_target": {
        "must_reach": true,
        "must_see": false,
        "entity_types": [
          {
            "filters": {
              "AND": [
                {
                  "test": "is_family",
                  "subject": 1,
                  "operator": 0,
                  "value": "monster"
                }
              ]
            }
          },
          {
            "filters": {
              "AND": [
                {
                  "test": "is_family",
                  "subject": 1,
                  "operator": 0,
                  "value": "hoglin"
                },
                {
                  "test": "is_difficulty",
                  "subject": 0,
                  "operator": 1,
                  "value": 0
                }
              ]
            }
          },
          {
            "filters": {
              "AND": [
                {
                  "test": "is_family",
                  "subject": 1,
                  "operator": 0,
                  "value": "zoglin"
                },
                {
                  "test": "is_difficulty",
                  "subject": 0,
                  "operator": 1,
                  "value": 0
                }
              ]
