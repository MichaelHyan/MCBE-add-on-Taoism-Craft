{
  "format_version": "1.26.0",
  "minecraft:entity": {
    "description": {
      "identifier": "entity:guide_fish",
      "is_summonable": true,
      "is_spawnable": false,
      "scripts": {
        "animate": [
          "guide_teleport",
          "guide_random",
          "guide_heart_fish",
          "guide_transform"
        ]
      },
      "animations": {
        "guide_teleport": "controller.animation.guide_teleport",
        "guide_random": "controller.animation.guide_random",
        "guide_heart_fish": "controller.animation.guide_heart_fish",
        "guide_transform": "controller.animation.guide_transform"
      }
    },
    "component_groups": {
      "transform": {
        "minecraft:transformation": {
          "into": "entity:guide"
        }
      },
      "hunter_mode": {
        "minecraft:navigation.generic": {
          "is_amphibious": true,
          "can_path_over_water": false,
          "can_swim": true,
          "can_walk": true
        }
      },
      "wander_mode": {
        "minecraft:navigation.generic": {
          "is_amphibious": true,
          "can_path_over_water": false,
          "can_swim": false,
          "can_walk": true
        }
      }
    },
    "components": {
      "minecraft:leashable_to": {},
      "minecraft:leashable": {},
      "minecraft:attack": {
        "damage": 1
      },
      "minecraft:behavior.melee_box_attack": {
        "priority": 3,
        "speed_multiplier": 1.4,
        "track_target": true,
        "require_complete_path": true
      },
      "minecraft:behavior.random_stroll": {
        "priority": 7,
        "speed_multiplier": 1
      },
      "minecraft:behavior.look_at_player": {
        "priority": 8,
        "look_distance": 8
      },
      "minecraft:behavior.random_look_around": {
        "priority": 9
      },
      "minecraft:breathable": {
        "breathes_air": true,
        "breathes_water": true,
        "suffocate_time": 0,
        "total_supply": 15
      },
      "minecraft:collision_box": {
        "height": 0.5,
        "width": 0.5
      },
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:experience_reward": {
        "on_death": {
          "expression": "query.last_hit_by_player ? 5 : 0",
          "version": 12
        }
      },
      "minecraft:follow_range": {
        "max": 32,
        "value": 32
      },
      "minecraft:health": {
        "max": 20,
        "value": 20
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "cause": "lava",
            "damage_per_tick": 4,
            "filters": {
              "operator": "==",
              "test": "in_lava",
              "subject": "self",
              "value": true
            }
          }
        ]
      },
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:jump.static": {},
      "minecraft:movement": {
        "value": 0.1
      },
      "minecraft:movement.generic": {},
      "minecraft:nameable": {},
      "minecraft:navigation.generic": {
        "is_amphibious": true,
        "can_path_over_water": false,
        "can_swim": false,
        "can_walk": true
      },
      "minecraft:on_target_acquired": {
        "event": "minecraft:has_target",
        "target": "self"
      },
      "minecraft:on_target_escape": {
        "event": "minecraft:lost_target",
        "target": "self"
      },
      "minecraft:underwater_movement": {
        "value": 0.1
      },
      "minecraft:physics": {},
      "minecraft:pushable_by_block": {},
      "minecraft:pushable_by_entity": {},
      "minecraft:renders_when_invisible": {},
      "minecraft:type_family": {
        "family": [
          "mob"
        ]
      }
    },
    "events": {
      "transform": {
        "add": {
          "component_groups": [
            "transform"
          ]
        }
      },
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "wander_mode"
          ]
        }
      },
      "minecraft:has_target": {
        "add": {
          "component_groups": [
            "hunter_mode"
          ]
        },
        "remove": {
          "component_groups": [
            "wander_mode"
          ]
        }
      },
      "minecraft:lost_target": {
        "add": {
          "component_groups": [
            "wander_mode"
          ]
        },
        "remove": {
          "component_groups": [
            "hunter_mode"
          ]
        }
      }
    }
  }
}