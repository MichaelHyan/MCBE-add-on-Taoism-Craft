{
  "format_version": "1.21.40",
  "minecraft:entity": {
    "description": {
      "identifier": "entity:spb_hmp_locked",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false,
      "scripts": {
        "animate": [
          "point_ctrl",
          "spb_hmp_lock_atk"
        ]
      },
      "animations": {
        "point_ctrl": "controller.animation.spb_hmp_locked",
        "spb_hmp_lock_atk": "controller.animation.spb_hmp_lock_atk"
      }
    },
    "components": {
      "minecraft:collision_box": {
        "width": 1,
        "height": 1
      },
      "minecraft:type_family": {
