          "mob",
          "taoism",
          "spb_hmp"
        ]
      },
      "minecraft:physics": {
        "has_gravity": false,
        "has_collision": true
      },
      "minecraft:knockback_resistance": {
        "value": 1.0
      },
      "minecraft:pushable": {
        "is_pushable": false,
        "is_pushable_by_piston": false
