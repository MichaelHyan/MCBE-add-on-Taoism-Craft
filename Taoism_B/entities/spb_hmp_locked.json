      "minecraft:conditional_bandwidth_optimization": {
        "default_values": {
          "max_optimized_distance": 100.0,
          "max_dropped_ticks": 7,
          "use_motion_prediction_hints": false
        }
      },
      "minecraft:variant": {
        "value": 2
      },
      "minecraft:timer": {
        "looping": false,
        "randomInterval": false,
        "time": 60.0,
