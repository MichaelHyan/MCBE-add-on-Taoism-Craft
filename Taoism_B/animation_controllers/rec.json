{
	"format_version": "1.8.0",
	"animation_controllers": {
		"controller.animation.rec":{
			"states":{
				"base_jeta":{
					"transitions":[
						{"rec_get":"query.get_equipped_item_name=='emerald' || query.is_item_equipped == 0 && query.scoreboard('rec_point') >= 300 && query.scoreboard('swordatkcd') >= 0"},
						{"rec_summon":"query.is_using_item && query.get_equipped_item_name=='rec' && query.scoreboard('swordatkcd') >= 0"}
					]
				},
				"rec_get": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/give @s emerald",
						"/scoreboard players set @s swordatkcd -3",
						"/scoreboard players add @s rec_point -300"
					]
				},
				"rec_summon": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/scoreboard objectives add rec_point dummy",
						"/scoreboard objectives add swordatkcd dummy",
						"/scoreboard players set @s swordatkcd -3",
						"/summon entity:rec"
					]
				}
			}
		}
 	}
 }