{
	"format_version": "1.8.0",
	"animation_controllers": {
		"controller.animation.visible":{
			"states":{
				"base_jeta":{
					"transitions":[
						{"visible":"query.life_time < 30"},
						{"invisible":"query.life_time > 30"}
					]
				},
				"visible": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/effect @e[family=invisibility] invisibility 0 255 true",
						"/scoreboard players set @e[family=invisibility] invisibility 1"
					]
				},
				"invisible": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/effect @e[family=invisibility] invisibility infinite 1 true",
						"/scoreboard players set @e[family=invisibility] invisibility 0"
					]
				}
			}
		}
 	}
 }