					]
				},
				"cooldown_a": {
					"on_entry": [
						"/scoreboard players add @s lottery 1"
					],
					"transitions": [
						{ "cooldown_b": "query.scoreboard('lottery') < 0" },
						{ "idle": "query.scoreboard('lottery') >= 0" }
					]
