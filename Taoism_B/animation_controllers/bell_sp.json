{
	"format_version": "1.8.0",
	"animation_controllers": {
		"controller.animation.bell_sp":{
			"states":{
				"base_jeta":{
					"transitions":[
						{"bell_sp_a":"query.life_time <= 5"},
						{"bell_sp_b":"query.life_time > 5"}
					]
				},
				"bell_sp_a": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/particle minecraft:blue_flame_particle ~ ~1 ~"
					]
				},
				"bell_sp_b": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/kill @s"
					]
				}
			}
		}
 	}
 }