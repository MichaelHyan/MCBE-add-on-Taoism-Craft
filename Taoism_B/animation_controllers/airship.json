					]
				},
				"airship_b": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/particle minecraft:campfire_smoke_particle ^ ^ ^-3",
						"/effect @e[type=pillager] slow_falling 1 1 true"
					]
				}
			}
		}
 	}
 }