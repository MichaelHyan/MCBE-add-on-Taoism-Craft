{
	"format_version": "1.8.0",
	"animation_controllers": {
		"controller.animation.seeker_sd":{
			"states":{
				"base_jeta":{
					"transitions":[
						{"seeker_a":"query.life_time <= 3"},
						{"seeker_b":"query.life_time > 3"}
					]
				},
				"seeker_a": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/particle minecraft:basic_flame_particle ~ ~1 ~",
						"/damage @e[type=player,r=3] 5",
						"/tp @s ^-0.5 ^0.05 ^ facing @n[type=entity:shandu]"
					]
				},
				"seeker_b": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/particle minecraft:basic_flame_particle ~ ~1 ~",
						"/damage @e[tag=shandu,r=3] 3",
						"/tp @s ^0.3 ^ ^0.7 facing @n[tag=shandu]"
					]
				}
			}
		}
 	}
 }