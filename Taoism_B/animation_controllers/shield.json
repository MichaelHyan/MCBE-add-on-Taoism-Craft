{
	"format_version": "1.8.0",
	"animation_controllers": {
		"controller.animation.shield":{
			"states":{
				"base_jeta":{
					"transitions":[
						{"shield_sprint":"query.get_equipped_item_name=='shield' && query.is_sprinting"},
						{"shield_defra":"query.get_equipped_item_name=='shield' && query.is_sneaking && query.scoreboard('shieldch') < 1"},
						{"shield_defrb":"query.get_equipped_item_name=='shield' && query.is_sneaking && query.scoreboard('shieldch') < 5 && query.scoreboard('shieldch') >= 1"},
						{"shield_defa":"query.get_equipped_item_name=='shield' && query.is_sneaking && query.scoreboard('shieldch') == 5"},
						{"shield_defb":"query.get_equipped_item_name=='shield' && query.is_sneaking && query.scoreboard('shieldch') == 6"},
						{"shield_defc":"query.get_equipped_item_name=='shield' && query.is_sneaking && query.scoreboard('shieldch') == 7"},
						{"shield_defd":"query.get_equipped_item_name=='shield' && query.is_sneaking && query.scoreboard('shieldch') == 8"},
						{"shield_defe":"query.get_equipped_item_name=='shield' && query.is_sneaking && query.scoreboard('shieldch') == 9"},
						{"shield_deff":"query.get_equipped_item_name=='shield' && query.is_sneaking && query.scoreboard('shieldch') == 10"},
						{"shield_defg":"query.get_equipped_item_name=='shield' && query.is_sneaking && query.scoreboard('shieldch') == 11"},
						{"shield_defh":"query.get_equipped_item_name=='shield' && query.is_sneaking && query.scoreboard('shieldch') == 12"},
						{"shield_defi":"query.get_equipped_item_name=='shield' && query.is_sneaking && query.scoreboard('shieldch') == 13"},
						{"shield_defj":"query.get_equipped_item_name=='shield' && query.is_sneaking && query.scoreboard('shieldch') == 14"},
						{"shield_defk":"query.get_equipped_item_name=='shield' && query.is_sneaking && query.scoreboard('shieldch') == 15"},
						{"shield_defl":"query.get_equipped_item_name=='shield' && query.is_sneaking && query.scoreboard('shieldch') == 16"},
						{"shield_release":"query.get_equipped_item_name=='shield' && !query.is_sneaking && query.scoreboard('shieldch') >= 15"}
					]
				},
				"shield_sprint": {
					"transitions": [
						{
							"base_jeta": "(1.0)"
						}
					],
					"on_entry": [
                        "/particle minecraft:cauldron_explosion_emitter ~ ~ ~",
						"/damage @e[type=!player,family=!taoism,type=!item,r=2] 4",
						"/effect @s resistance 1 3 true"
					]
				},
                "shield_defra": {
					"transitions": [
						{
							"base_jeta": "(1.0)"
						}
					],
					"on_entry": [
                        "/effect @s resistance 1 255 true",
						"/scoreboard objectives add shieldch dummy",
						"/scoreboard players add @s shieldch 1"
					]
				},
				"shield_defrb": {
					"transitions": [
						{
							"base_jeta": "(1.0)"
						}
					],
					"on_entry": [
						"/scoreboard players add @s shieldch 1"
					]
				},
				"shield_defa": {
					"transitions": [
						{
							"base_jeta": "(1.0)"
						}
					],
					"on_entry": [
						"/particle minecraft:end_chest ~ ~0.5 ~",
						"/scoreboard players add @s shieldch 1",
						"/title @s actionbar §7§0||||||||||"
					]
				},
