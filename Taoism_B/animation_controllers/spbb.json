{
	"format_version": "1.8.0",
	"animation_controllers": {
		"controller.animation.spbb":{
			"states":{
				"base_jeta":{
					"transitions":[
						{"spbb_a":"query.life_time <= 1"},
						{"spbb_b":"query.life_time == 1.2"},
						{"spbb_c":"query.life_time > 1.2"}
					]
				},
				"spbb_a": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/particle minecraft:villager_happy ~ ~ ~",
						"/damage @e[tag=spbc,tag=!spbb,r=2] 15",
						"/tag @e[type=!player,type=!item,family=!taoism,r=2] add spbb",
						"/effect @e[tag=spbb,r=2] poison 60 1",
						"/tag @e[r=2] remove spbc"
					]
				},
				"spbb_b": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/particle minecraft:large_explosion",
						"/effect @s invisibility 1 1 true",
						"/kill @s"
					]
				},
				"spbb_c": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/effect @s invisibility 1 1 true",
						"/kill @s"
					]
				}
			}
		}
 	}
 }