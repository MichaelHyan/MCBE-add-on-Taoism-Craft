{
	"format_version": "1.8.0",
	"animation_controllers": {
		"controller.animation.dragon":{
			"states":{
				"base_jeta":{
					"transitions":[
						{"notdie":"query.is_alive != 0"},
						{"die":"query.is_alive == 0 && query.scoreboard('relic') == 1"}
					]
				},
				"notdie": {
					"transitions": [
						{
							"base_jeta": "(1.0)"
						}
					],
					"on_entry": [
						"/kill @e[family=relic]",
						"/scoreboard objectives add relic dummy",
						"/scoreboard players set @s relic 1"
					]
				},
				"die": {
					"transitions": [
						{
							"base_jeta": "(1.0)"
						}
					],
					"on_entry": [
						"/kill @e[family=relic]",
						"/summon entity:relic",
						"/scoreboard players set @s relic 0"
					]
				}
			}
		}
 	}
 }