{
	"format_version": "1.8.0",
	"animation_controllers": {
		"controller.animation.partner":{
			"states":{
				"base_jeta":{
					"transitions":[
						{"chat_a":"query.is_item_name_any('slot.weapon.mainhand', 0, 'items:cinnabar_powder')"},
						{"chat_sa":"query.is_item_name_any('slot.weapon.mainhand', 0, 'items:sword_s')"},
						{"chat_sb":"query.is_item_name_any('slot.weapon.mainhand', 0, 'items:pearl')"},
						{"chat_sc":"query.is_item_name_any('slot.weapon.offhand', 0, 'minecraft:totem_of_undying')"}
					]
				},
				"chat_a": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/kill @e[type=entity:chata]",
						"/summon entity:chata",
						"/effect @s slowness 34 255 true",
						"/replaceitem entity @s slot.weapon.mainhand 0 air"
					]
				},
				"chat_sa": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/say 哇！金色传说！",
						"/replaceitem entity @s slot.weapon.mainhand 0 air"
					]
				},
				"chat_sb": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/say 内丹、长生、飞升…… 终究不过是镜花水月，一场空幻。",
						"/replaceitem entity @s slot.weapon.mainhand 0 air"
					]
				},
				"chat_sc": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/kill @e[type=entity:chatb]",
						"/summon entity:chatb",
						"/effect @s slowness 40 255 true",
						"/replaceitem entity @s slot.weapon.offhand 0 air"
					]
				}
			}
		}
 	}
 }