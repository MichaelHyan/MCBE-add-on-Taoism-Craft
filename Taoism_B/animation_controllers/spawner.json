{
	"format_version": "1.8.0",
	"animation_controllers": {
		"controller.animation.spawner":{
			"states":{
				"base_jeta":{
					"transitions":[
						{"spw_a":"query.moon_phase != 0 && query.moon_phase != 4"},
						{"spw_b":"query.life_time == 10 && query.moon_phase == 0 || query.moon_phase == 4"}
					]
				},
				"spw_a": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/kill @s"
					]
				},
				"spw_b": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/summon entity:zombie_mimic"
					]
				}
			}
		}
 	}
 }