{
	"format_version": "1.8.0",
	"animation_controllers": {
		"controller.animation.cannon":{
			"states":{
				"base_jeta":{
					"transitions":[
						{"cannon_a":"query.life_time > 1 && query.vertical_speed > -1"},
						{"cannon_b":"query.life_time > 1 && query.vertical_speed < -1"}
					]
				},
				"cannon_a": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/kill @s",
						"/summon entity:cannon_explosion"
					]
				},
				"cannon_b": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/particle minecraft:campfire_smoke_particle ~ ~ ~"
					]
				}
			}
		}
 	}
 }