{
	"format_version": "1.8.0",
	"animation_controllers": {
		"controller.animation.adaptionaddon":{
			"states":{
				"base_jeta":{
					"transitions":[
						{"adaption_a":"query.is_in_water && query.scoreboard('adaptionaddon') == 1"},
						{"adaption_b":"query.is_on_fire && query.scoreboard('adaptionaddon') >= 2"},
						{"adaption_c":"query.is_in_water_or_rain && query.scoreboard('adaptionaddon') == 3"},
						{"adaption_d":"query.is_in_lava && query.scoreboard('adaptionaddon') == 3"}
					]
				},
				"adaption_a": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/effect @s water_breathing 2 1 true"
					]
				},
				"adaption_b": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/effect @s fire_resistance 2 1 true"
					]
				},
				"adaption_c": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/effect @s conduit_power 2 1 true"
					]
				},
				"adaption_d": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/effect @s fire_resistance 2 1 true"
					]
				}
			}
		},
		"controller.animation.seekeraddon":{
			"states":{
				"base_jeta":{
					"transitions":[
						{"seeker_a":"query.get_equipped_item_name=='pearl' && query.scoreboard('spb') == 0 && query.is_using_item && query.scoreboard('charge') == 0 && query.scoreboard('seekeraddon') == 1"},
						{"seeker_b":"query.get_equipped_item_name=='pearl' && query.scoreboard('spb') == 0 && query.is_using_item && query.scoreboard('charge') == 0 && query.scoreboard('seekeraddon') >= 2"},
						{"seeker_c":"query.get_equipped_item_name=='pearl' && query.scoreboard('spb') == 0 && query.is_sneaking && query.scoreboard('charge') >= 0 && query.scoreboard('seekeraddon') == 3"}
					]
				},
				"seeker_a": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/summon entity:seeker_item"
					]
				},
				"seeker_b": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/summon entity:seeker_item",
						"/summon entity:detector"
					]
				},
				"seeker_c": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/tp @n[type=entity:detector]",
						"/scoreboard players set @s charge -4"
					]
				}
			}
		}
 	}
 }