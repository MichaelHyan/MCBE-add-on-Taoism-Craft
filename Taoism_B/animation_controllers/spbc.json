{
	"format_version": "1.8.0",
	"animation_controllers": {
		"controller.animation.spbc":{
			"states":{
				"base_jeta":{
					"transitions":[
						{"spbc_a":"query.life_time <= 1"},
						{"spbc_b":"query.life_time == 1.2"},
						{"spbc_c":"query.life_time > 1.2"}
					]
				},
				"spbc_a": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/particle minecraft:sculk_sensor_redstone_particle ~ ~ ~",
						"/damage @e[tag=spba,tag=!spbc,r=2] 15",
						"/tag @e[type=!player,type=!item,family=!taoism,r=2] add spbc",
						"/effect @e[tag=spbc,r=2] weakness 60 1",
						"/tag @e[r=2] remove spba"
					]
				},
				"spbc_b": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/particle minecraft:large_explosion",
						"/effect @s invisibility 1 1 true",
						"/kill @s"
					]
				},
				"spbc_c": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/effect @s invisibility 1 1 true",
						"/kill @s"
					]
				}
			}
		}
 	}
 }