{
	"format_version": "1.8.0",
	"animation_controllers": {
		"controller.animation.spbc":{
			"states":{
				"base_jeta":{
					"transitions":[
						{"spbc_a":"query.life_time <= 3"},
						{"spbc_b":"query.life_time > 3"}
					]
				},
				"spbc_a": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/particle minecraft:sculk_sensor_redstone_particle ~ ~ ~",
						"/effect @e[family=!monster,r=5] regeneration 1 5 true"
					]
				},
				"spbc_b": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/particle minecraft:totem_particle ~ ~ ~",
						"/effect @e[family=!monster,r=5] instant_health 1 1 true",
						"/effect @s invisibility 1 1 true",
						"/kill @s"
					]
				}
			}
		}
 	}
 }