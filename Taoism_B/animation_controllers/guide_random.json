{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.guide_random": {
			"initial_state": "base_jeta",
			"states": {
				"base_jeta": {
					"on_entry": [
						"v.guide_next = query.life_time + 300.0;"
					],
					"transitions": [
						{ "roll": "query.life_time >= v.guide_next" }
					]
				},
				"roll": {
					"on_entry": [
						"v.guide_pick = math.random_integer(0, 34);"
					],
					"transitions": [
						{ "tips_a": "v.guide_pick == 0" },
						{ "tips_b": "v.guide_pick == 1" },
						{ "tips_c": "v.guide_pick == 2" },
						{ "tips_d": "v.guide_pick == 3" },
						{ "tips_e": "v.guide_pick == 4" },
						{ "tips_f": "v.guide_pick == 5" },
