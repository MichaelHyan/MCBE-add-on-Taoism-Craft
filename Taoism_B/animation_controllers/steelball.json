{
  "format_version": "1.8.0",
  "animation_controllers": {
    "controller.animation.steelball": {
      "initial_state": "wait",
      "states": {
        "wait": {
          "transitions": [
            {
              "give": "query.life_time > 1.0"
            }
          ]
        },
        "give": {
          "on_entry": [
            "/give @p items:steelball"
          ],
          "transitions": []
        }
      }
    }
  }
}