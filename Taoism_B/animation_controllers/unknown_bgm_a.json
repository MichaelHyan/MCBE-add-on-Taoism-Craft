{
	"format_version": "1.8.0",
	"animation_controllers": {
		"controller.animation.unknown_bgm_a":{
			"states":{
				"base_jeta":{
					"transitions":[
						{"boss_dead":"query.is_alive == 0"},
						{"boss_bgm":"math.mod(query.life_time,176) == 88"}
					]
				},
				"boss_bgm": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/function bgmstop",
						"/function bgmbsp1"
					]
				},
				"boss_dead": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/function bgmstop",
						"/fill 29 201 29 -29 201 -29 air",
						"/kill @e[family=reb]",
						"/summon entity:rebm"
					]
				}
			}
		}
 	}
 }