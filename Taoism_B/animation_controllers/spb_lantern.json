{
	"format_version": "1.8.0",
	"animation_controllers": {
		"controller.animation.spb_lantern":{
			"states":{
				"base_jeta":{
					"transitions":[
						{"spb_lantern_a":"query.life_time <= 180 && math.mod(query.life_time,1) == 0"},
						{"spb_lantern_b":"query.life_time > 180"}
					]
				},
				"spb_lantern_a": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/particle minecraft:villager_angry ~ ~1 ~"
					]
				},
				"spb_lantern_b": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/kill @s"
					]
				}
			}
		}
 	}
 }