{
	"format_version": "1.8.0",
	"animation_controllers": {
		"controller.animation.spba":{
			"states":{
				"base_jeta":{
					"transitions":[
						{"spba_a":"query.life_time <= 3"},
						{"spba_b":"query.life_time > 3"}
					]
				},
				"spba_a": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/particle minecraft:balloon_gas_particle ~ ~ ~"
					]
				},
				"spba_b": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/effect @s invisibility 1 1 true",
						"/kill @s"
					]
				}
			}
		}
 	}
 }