{
	"format_version": "1.8.0",
	"animation_controllers": {
		"controller.animation.spb":{
			"states":{
				"base_jeta":{
					"transitions":[
						{"spba_a":"query.get_equipped_item_name=='spba' && query.is_sneaking && variable.attack_time && query.scoreboard('charge') >= 0 && query.player_level > 29"},
						{"spba_b":"query.get_equipped_item_name=='spba' && query.player_level > 29"},
						{"spbb_a":"query.get_equipped_item_name=='spbb' && query.is_sneaking && variable.attack_time && query.scoreboard('charge') >= 0 && query.player_level > 14"},
						{"spbc_a":"query.get_equipped_item_name=='spbc' && query.is_sneaking && variable.attack_time && query.scoreboard('charge') >= 0 && query.player_level > 19"},
						{"spbd_a":"query.get_equipped_item_name=='spbd' && query.is_sneaking && variable.attack_time && query.scoreboard('charge') >= 0 && query.player_level > 24"},
						{"spbe_a":"query.get_equipped_item_name=='spbe' && query.is_sneaking && variable.attack_time && query.scoreboard('charge') >= 0 && query.player_level > 19"},
						{"spbd_follow":"query.get_equipped_item_name=='spbb' || query.get_equipped_item_name=='spbc' || query.get_equipped_item_name=='spbd' || query.get_equipped_item_name=='spbe'"}
					]
				},
				"spba_a": {
					"transitions": [
						{
							"base_jeta": "(1.0)"
						}
					],
					"on_entry": [
						"/particle minecraft:totem_particle ~ ~1 ~",
						"/damage @e[tag=spba] 20",
						"/tag @e remove spba",
						"/damage @e[tag=spbb] 20",
						"/tag @e remove spbb",
						"/damage @e[tag=spbc] 20",
						"/tag @e remove spbc",
						"/damage @e[tag=spbd] 20",
						"/tag @e remove spbd",
						"/damage @e[tag=spbe] 20",
						"/tag @e remove spbe",
						"/scoreboard players set @s charge -100"
					]
				},
				"spba_b": {
					"transitions": [
						{
							"base_jeta": "(1.0)"
						}
					],
					"on_entry": [
						"/tp @e[type=entity:spb_lantern] ^-0.5 ^ ^-0.5",
						"/damage @e[tag=spbx] 10",
						"/tag @e remove spbx"
					]
				},
				"spbb_a": {
					"transitions": [
						{
							"base_jeta": "(1.0)"
						}
					],
					"on_entry": [
						"/particle minecraft:totem_particle ~ ~1 ~",
						"/summon entity:spb_life",
						"/scoreboard players set @s charge -100"
					]
				},
				"spbc_a": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/particle minecraft:totem_particle ~ ~1 ~",
						"/effect @e[family=!monster,r=3] regeneration 5 5 true",
						"/scoreboard players set @s charge -100"
					]
				},
				"spbd_a": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/particle minecraft:totem_particle ~ ~1 ~",
						"/kill @e[type=entity:spb_lantern]",
						"/summon entity:spb_lantern",
						"/scoreboard players set @s charge -100"
					]
				},
				"spbe_a": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/particle minecraft:totem_particle ~ ~1 ~",
						"/summon entity:tornado",
						"/scoreboard players set @s charge -100"
					]
				},
				"spbd_follow": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/tp @e[type=entity:spb_lantern] ^-0.5 ^ ^-0.5"
					]
				}
			}
		}
 	}
 }